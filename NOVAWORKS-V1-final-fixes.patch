diff -ruN nwfinal/novaworks/src/routes/_authenticated/dashboard.receptionist.index.tsx nwpatch/src/routes/_authenticated/dashboard.receptionist.index.tsx
--- a/src/routes/_authenticated/dashboard.receptionist.index.tsx	1970-01-01 00:00:00.000000000 +0000
